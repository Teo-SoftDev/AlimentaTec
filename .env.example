# Copie este archivo a .env.local y ajuste. Todas son opcionales: si no existen,
# se usa la configuración por defecto del proyecto alimentatec-2aae9.
# (La apiKey de Firebase Web NO es un secreto; la seguridad real está en
#  firestore.rules + Authentication + App Check.)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# App Check (reCAPTCHA v3). Recomendado en producción.
VITE_APPCHECK_SITE_KEY=
# Solo desarrollo local:
VITE_APPCHECK_DEBUG_TOKEN=
