    {
      "name": "5. Lote offline (con marcas de tiempo pasadas)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "// Genera lecturas realistas con ligera fluctuación aleatoria según el modo (variable {{mode}}).",
              "const mode = pm.environment.get('mode') || 'normal';",
              "const j = (a) => (Math.random() - 0.5) * 2 * a;",
              "const prev = JSON.parse(pm.environment.get('last_state') || '{\"t\":14.2,\"ph\":7.4,\"o\":7.8,\"l\":86}');",
              "const target = {",
              "  t: mode === 'high-temp' ? 22.5 : 14.2,",
              "  ph: mode === 'ph-drift' ? 6.1 : 7.4,",
              "  o: mode === 'low-oxygen' ? 3.8 : 7.8,",
              "  l: mode === 'low-level' ? 42 : 86,",
              "};",
              "const sp = mode === 'normal' ? 0.15 : 0.45;",
              "const st = { t: prev.t + (target.t - prev.t) * sp + j(0.08), ph: prev.ph + (target.ph - prev.ph) * sp + j(0.03), o: prev.o + (target.o - prev.o) * sp + j(0.12), l: prev.l + (target.l - prev.l) * sp + j(0.4) };",
              "pm.environment.set('last_state', JSON.stringify(st));",
              "const r = (v, d) => Math.round(v * 10 ** d) / 10 ** d;",
              "pm.environment.set('readingId', 'pm' + Math.random().toString(36).slice(2, 12) + Date.now().toString(36));",
              "pm.environment.set('temperature', r(st.t, 2));",
              "pm.environment.set('ph', r(st.ph, 2));",
              "pm.environment.set('oxygen', r(st.o, 2));",
              "pm.environment.set('waterLevel', r(st.l, 1));",
              "",
              "pm.environment.set('ts1', Date.now() - 600000);",
              "pm.environment.set('ts2', Date.now() - 300000);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Lote procesado', () => pm.response.to.have.status(200));",
              "const j = pm.response.json();",
              "pm.test('Sin rechazos', () => pm.expect(j.rejected).to.eql(0));"
            ]
          }
        }
